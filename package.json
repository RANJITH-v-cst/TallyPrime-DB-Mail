{
  "name": "tally-daybook-mailer",
  "version": "1.0.0",
  "description": "Windows middleware application that automatically exports TallyPrime Day Books for multiple companies and emails them on schedule",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node -e \"fs.cpSync('src/ui/public', 'dist/ui/public', {recursive: true, force: true})\"",
    "start": "tsc && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "mock-tally": "ts-node src/mock/mockTallyServer.ts",
    "service:install": "node service/install-service.js",
    "service:uninstall": "node service/uninstall-service.js"
  },
  "keywords": [
    "tally",
    "tallyprime",
    "daybook",
    "excel",
    "mailer",
    "windows-service",
    "tdl"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "node-cron": "^3.0.3",
    "node-windows": "^0.1.14",
    "nodemailer": "^6.10.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
